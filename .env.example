# LLM providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
CO_API_KEY=

# Qdrant (use http://qdrant:6333 inside Docker, http://localhost:6333 locally)
QDRANT_URL=http://localhost:6333

# LangSmith (optional, for tracing & evals)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=RAG-Tracing
