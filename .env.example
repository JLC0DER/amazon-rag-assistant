# LLM providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
CO_API_KEY=

# Qdrant (use http://qdrant:6333 inside Docker, http://localhost:6333 locally)
QDRANT_URL=http://localhost:6333

# Postgres / LangGraph checkpoints (set your own local values; do not commit real secrets)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Used by the API inside Docker, e.g. postgresql://USER:PASSWORD@postgres:5432/DB
POSTGRES_URI=

# LangSmith (optional, for tracing & evals)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=RAG-Tracing
